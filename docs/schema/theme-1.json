{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "sivi theme, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "theme", "page", "colors", "typography", "text", "inline", "lists", "code", "tables", "quotes", "masters"],
  "definitions": {
    "length": { "type": "string", "pattern": "^[0-9]*(\\.[0-9]{0,3})?pt$" },
    "measure": { "type": "string", "pattern": "^[0-9]*(\\.[0-9]{0,3})?(pt|em)$" },
    "along": { "type": "string", "pattern": "^[0-9]*(\\.[0-9]{0,3})?(pt|%)$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
    "styleName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "align": { "type": "string", "enum": ["left", "center", "right"] },
    "valign": { "type": "string", "enum": ["top", "middle", "bottom"] },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "$ref": "#/definitions/along" },
        "y": { "$ref": "#/definitions/along" },
        "width": { "$ref": "#/definitions/along" },
        "height": { "$ref": "#/definitions/along" }
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string", "enum": ["italic", "color"] },
        "color": { "$ref": "#/definitions/styleName" },
        "weight": { "$ref": "#/definitions/weight" },
        "font": { "type": "string", "minLength": 1 },
        "background": { "$ref": "#/definitions/styleName" },
        "underline": { "type": "boolean" }
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font", "size", "weight", "color", "line_height"],
      "properties": {
        "font": { "type": "string", "minLength": 1 },
        "size": { "$ref": "#/definitions/length" },
        "weight": { "$ref": "#/definitions/weight" },
        "color": { "$ref": "#/definitions/styleName" },
        "line_height": { "type": "number", "minimum": 0 },
        "align": { "$ref": "#/definitions/align" }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binds", "region", "text"],
      "properties": {
        "binds": { "type": "string", "enum": ["title", "subtitle", "section", "flow"] },
        "section": { "type": "integer", "minimum": 1 },
        "accepts": {
          "type": "array",
          "items": { "type": "string", "enum": ["heading", "paragraph", "list", "code", "quote", "image", "table"] }
        },
        "required": { "type": "boolean" },
        "follows": { "$ref": "#/definitions/identifier" },
        "region": { "$ref": "#/definitions/region" },
        "text": { "$ref": "#/definitions/styleName" },
        "valign": { "$ref": "#/definitions/valign" },
        "align": { "$ref": "#/definitions/align" },
        "max_blocks": { "type": "integer", "minimum": 0 },
        "max_items": { "type": "integer", "minimum": 0 },
        "max_depth": { "type": "integer", "minimum": 0 },
        "max_rows": { "type": "integer", "minimum": 0 },
        "max_columns": { "type": "integer", "minimum": 0 },
        "max_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "decor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "region"],
      "properties": {
        "kind": { "type": "string", "enum": ["rect", "image", "page_number", "field"] },
        "region": { "$ref": "#/definitions/region" },
        "color": { "$ref": "#/definitions/styleName" },
        "path": { "type": "string", "minLength": 1 },
        "text": { "$ref": "#/definitions/styleName" },
        "align": { "$ref": "#/definitions/align" },
        "format": { "type": "string", "pattern": "\\{n\\}" },
        "field": { "type": "string", "enum": ["title", "author", "date"] }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/slot" }
        },
        "decor": { "type": "array", "items": { "$ref": "#/definitions/decor" } }
      }
    }
  },
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/definitions/identifier" } }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "$ref": "#/definitions/length" },
        "height": { "$ref": "#/definitions/length" },
        "background": { "$ref": "#/definitions/styleName" }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/color" }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_size", "paragraph_gap"],
      "properties": {
        "min_size": { "$ref": "#/definitions/length" },
        "paragraph_gap": { "$ref": "#/definitions/measure" },
        "fallback": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/textStyle" }
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emphasis", "strong", "code", "link"],
      "properties": {
        "emphasis": { "$ref": "#/definitions/mark" },
        "strong": { "$ref": "#/definitions/mark" },
        "code": { "$ref": "#/definitions/mark" },
        "link": { "$ref": "#/definitions/mark" }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bullets", "ordered", "indent", "gap"],
      "properties": {
        "bullets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ordered": { "type": "string" },
        "indent": { "$ref": "#/definitions/measure" },
        "gap": { "$ref": "#/definitions/measure" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font", "size", "line_height", "background", "padding", "highlight", "tab_width"],
      "properties": {
        "font": { "type": "string", "minLength": 1 },
        "size": { "$ref": "#/definitions/length" },
        "line_height": { "type": "number", "minimum": 0 },
        "background": { "$ref": "#/definitions/styleName" },
        "padding": { "$ref": "#/definitions/length" },
        "highlight": { "type": "boolean" },
        "tab_width": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "header_weight", "rule", "padding"],
      "properties": {
        "text": { "$ref": "#/definitions/styleName" },
        "header_weight": { "$ref": "#/definitions/weight" },
        "rule": { "$ref": "#/definitions/styleName" },
        "padding": { "$ref": "#/definitions/length" }
      }
    },
    "quotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bar", "bar_width", "indent"],
      "properties": {
        "bar": { "$ref": "#/definitions/styleName" },
        "bar_width": { "$ref": "#/definitions/length" },
        "indent": { "$ref": "#/definitions/length" }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "path", "sha256"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "\\.(ttf|otf)$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "masters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/master" }
    }
  }
}
