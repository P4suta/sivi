{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // The shared preset holds the schedule, grouping, digest pins, and automerge policy.
  extends: ['github>P4suta/renovate-config'],
  // A release waits three days before Renovate proposes it, so a pulled release never reaches a host.
  minimumReleaseAge: '3 days',
  enabledManagers: ['github-actions', 'mise', 'cargo', 'dockerfile', 'custom.regex'],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^xtask/src/containers\\.rs$/'],
      matchStrings: ['(?<depName>docker\\.io/[a-z0-9_/-]+):(?<currentValue>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]{64})'],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // The Typst crates move together, so one pull request carries the whole family.
      matchManagers: ['cargo'],
      matchPackageNames: ['/^typst/'],
      groupName: 'typst',
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
      labels: ['breaking-change'],
    },
  ],
}
